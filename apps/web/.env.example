# Google Gemini API Key (untuk fitur AI Mental Support Companion & Mood + Food Analyzer)
GEMINI_API_KEY=your_gemini_api_key_here

# Opsional: Kosongkan saat deploy 1 proyek dengan Vercel Services karena rute /api/v1 otomatis satu domain.
# Di mode development lokal (pnpm dev), Next.js otomatis mem-proxy ke http://localhost:4000.
NEXT_PUBLIC_API_URL=

# PostgreSQL lokal; gunakan port server Anda (misalnya 5433).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/permata
BACKEND_API_URL=http://localhost:4000

# Ganti dengan secret acak untuk menandatangani sesi login lokal.
AUTH_SESSION_SECRET=replace-with-at-least-32-char-secret-here

# RAG (AI Companion chat, pgvector)
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIM=768
RAG_TOP_K=4
